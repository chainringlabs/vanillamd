# Supply-chain settings. They apply to every npm install: laptop, CI and the image build.

# Only resolve versions published at least 7 days ago, so a compromised release
# has time to be caught and pulled. Versions already in package-lock.json are
# installed as locked.
min-release-age=7

# Do not run dependency install scripts (preinstall/install/postinstall), the
# usual way a malicious package executes code. Nothing here needs one. This also
# skips pre/post hooks on `npm run`, so do not rely on those.
ignore-scripts=true
